package = "lexiftool"
version = "scm-0"
source = {
  url = "https://github.com/blitzview-org/lexiftool/archive/master.zip",
  dir = "lexiftool-master",
}
description = {
  summary = "Lua port of ExifTool: read and write meta information in files",
  homepage = "https://github.com/blitzview-org/lexiftool",
  license = "Artistic-1.0-Perl OR GPL-1.0-or-later",
  detailed = [[
      lexiftool is a structural Lua port of ExifTool by Phil Harvey (the
      Image::ExifTool Perl library and the exiftool command-line
      application). It reads and writes metadata in the same file formats,
      with the same tag names, the same options and the same output. The
      rock installs the library (require "lexiftool") and the command-line
      tool lexiftool.
  ]],
}
-- The version is the ExifTool release the port tracks plus a port patch
-- level (13.59 -> 13.59.0); the rockspec revision follows the dash. It is
-- the same string `lexiftool -ver -v` prints as "lexiftool port ...".
--
-- lbrotli is an optional dependency of the library (without it, Brotli-
-- compressed metadata is reported as exiftool does without
-- IO::Uncompress::Brotli). LuaRocks has no optional dependencies, so the rock
-- requires it: a rock installation always behaves completely, at the cost of
-- needing libbrotli at build time.
dependencies = {
  "lua >= 5.4, < 5.6",
  "carray",
  "lpcre >= 0.0.1",
  "lbrotli >= 0.0.1",
  "luafilesystem",
  "md5",
  "lua-zlib",
}
build = {
  type = "builtin",
  modules = {
    -- the port's C helper ($^O, setenv/tzset, chmod, truncate, %SIG, ReadKey);
    -- needs only the C runtime
    ["lexiftool.sys"] = {
      sources = { "src/lexiftool/sys.c" },
    },
    -- Lua modules, generated by rockspecs/update_modules.lua -- do not edit
    -- BEGIN LUA MODULES
    ["lexiftool"]                        = "src/lexiftool.lua",
    ["lexiftool.7Z"]                     = "src/lexiftool/7Z.lua",
